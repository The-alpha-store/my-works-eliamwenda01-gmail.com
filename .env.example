# Copy this file to ".env" (same folder as settings.gradle.kts) and fill in your own values.
# ".env" is ignored by Git. NEVER commit it.
#
# Where to find the two values: Supabase dashboard > Project Settings > API
#   SUPABASE_URL      = "Project URL"                  e.g. https://abcd1234efgh.supabase.co
#   SUPABASE_ANON_KEY = "anon" / "publishable" key      (safe to ship inside the app)
#
# NEVER put the service_role / secret key here, in the app, or in Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Fake people and sample data for looking around. Must stay false for a real build.
DEMO_MODE_ENABLED=false
